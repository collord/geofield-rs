{
  "name": "geofield-web3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:kernel": "cargo build -p geofield-kernel --release --target wasm32-unknown-unknown --features wasm-abi && mkdir -p src/wasm-kernel && cp ../target/wasm32-unknown-unknown/release/geofield_kernel.wasm src/wasm-kernel/geofield_kernel.wasm",
    "wasm:engine": "wasm-pack build ../crates/geofield --release --target web --out-dir ../../web3/src/wasm -- --features wasm",
    "wasm:engine:exact": "wasm-pack build ../crates/geofield --release --target web --out-dir ../../web3/src/wasm -- --features wasm,exact_arr",
    "wasm": "npm run wasm:kernel && npm run wasm:engine",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:exact": "npm run wasm:engine:exact && npm run build && playwright test exact-determinism"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "manifold-3d": "^3.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
